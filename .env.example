PORT=5000
NODE_ENV=production
FRONTEND_URL=https://leadqualify-agent.vercel.app/
BASE_URL=http://localhost:5000

# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/kooi-mvp

# Auth
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Bolna
BOLNA_API_KEY=BOLNA_API_KEY
BOLNA_AGENT_ID=BOLNA_AGENT_ID

# Gemini key
GEMINI_API_KEY=GEMINI_API_KEY
GEMINI_MODEL=GEMINI_MODEL

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Webhook (for Bolna batch callbacks)
WEBHOOK_SECRET=your_super_secret_webhook_key_here
WEBHOOK_BASE_URL=https://choice-creatable-facility.ngrok-free.dev

SKIP_CROSS_BATCH_DEDUP=false