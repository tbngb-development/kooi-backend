generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// AUTH & MULTI-TENANCY
// ─────────────────────────────────────────────────────────────────────────────

model Tenant {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   TenantUser[]
  bolnaApiKeyId String?
  bolnaApiKey   BolnaApiKey?   @relation(fields: [bolnaApiKeyId], references: [id])
  tenantPlan    TenantPlan?
  wallet        Wallet?
  campaigns     Campaign[]
  batches       LeadBatch[]
  leads         Lead[]
  calls         Call[]
  assistants    Assistant[]
  brochures     Brochure[]
  callAnalyses  CallAnalysis[]

  @@index([email])
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   TenantUser[]
  platformAdmin PlatformAdmin?
  refreshTokens RefreshToken[]
}

model TenantUser {
  id        String     @id @default(uuid())
  userId    String
  tenantId  String
  role      TenantRole @default(USER)
  createdAt DateTime   @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
}

enum TenantRole {
  OWNER
  ADMIN
  USER
}

model PlatformAdmin {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// ASSISTANT
// ─────────────────────────────────────────────────────────────────────────────

model Assistant {
  id        String   @id @default(uuid())
  bolnaId   String
  name      String
  tenantId  String
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  platformAgentId String?

  platformAgent   PlatformAgent? @relation(fields: [platformAgentId], references: [id], onDelete: SetNull)
  
  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  campaigns Campaign[]
}

// ─────────────────────────────────────────────────────────────────────────────
// BROCHURE
// ─────────────────────────────────────────────────────────────────────────────

model Brochure {
  id       String @id @default(uuid())
  tenantId String

  originalFileName String
  fileSizeMB       String
  pageCount        Int
  rawTextLength    Int

  projectName    String?
  developerName  String?
  reraNumber     String?
  projectWebsite String?
  contactNumber  String?

  city        String?
  area        String?
  state       String?
  landmark    String?
  fullAddress String?

  propertyTypes  String[]
  configurations String[]
  totalUnits     Int?
  totalTowers    Int?
  totalFloors    Int?
  sizeMin        Float?
  sizeMax        Float?
  sizeUnit       String?

  startingPrice     Float?
  maxPrice          Float?
  pricePerSqft      Float?
  priceLabel        String?
  paymentPlan       String?
  bankApprovals     String[]
  maintenanceCharge String?

  possessionDate     String?
  launchDate         String?
  constructionStatus String? @default("unknown")

  amenities            String[]
  specifications       String[]
  nearbyInfrastructure String[]
  usps                 String[]

  minimumBudget          Float?
  maximumBudget          Float?
  targetBuyerProfile     String?
  preferredLocations     String[]
  investmentType         String[]
  keyQualifyingQuestions String[]

  confidence         Float    @default(0)
  extractionWarnings String[]

  isConfirmed Boolean   @default(false)
  confirmedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  campaigns Campaign[]

  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────────────────────
// CAMPAIGN
// ─────────────────────────────────────────────────────────────────────────────

model Campaign {
  id                 String         @id @default(uuid())
  name               String
  description        String?
  status             CampaignStatus @default(DRAFT)
  tenantId           String
  assistantId        String
  brochureId         String?
  variables          Json?
  defaultRetryConfig Json?
  totalLeads         Int            @default(0)
  calledLeads        Int            @default(0)
  completedLeads     Int            @default(0)
  failedLeads        Int            @default(0)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  startedAt          DateTime?
  completedAt        DateTime?

  tenant    Tenant      @relation(fields: [tenantId], references: [id])
  assistant Assistant   @relation(fields: [assistantId], references: [id])
  brochure  Brochure?   @relation(fields: [brochureId], references: [id])
  leads     Lead[]
  calls     Call[]
  batches   LeadBatch[]

  @@index([brochureId])
}

enum CampaignStatus {
  DRAFT
  RUNNING
  COMPLETED
  FAILED
}

// ─────────────────────────────────────────────────────────────────────────────
// LEAD BATCH
// ─────────────────────────────────────────────────────────────────────────────

model LeadBatch {
  id                String      @id @default(uuid())
  bolnaBatchId      String?     @unique
  campaignId        String
  tenantId          String
  status            BatchStatus @default(CREATED)
  fileName          String?
  originalFileUrl   String?
  transformedCsvUrl String?
  totalLeads        Int         @default(0)
  calledLeads       Int         @default(0)
  completedLeads    Int         @default(0)
  failedLeads       Int         @default(0)
  retryConfig       Json?
  scheduledAt       DateTime?
  bolnaScheduledAt  DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  startedAt         DateTime?
  completedAt       DateTime?

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leads    Lead[]
  calls    Call[]

  @@index([tenantId])
  @@index([campaignId])
  @@index([bolnaBatchId])
}

enum BatchStatus {
  CREATED
  SCHEDULED
  RUNNING
  STOPPED
  COMPLETED
  FAILED
}

// ─────────────────────────────────────────────────────────────────────────────
// LEAD
// ─────────────────────────────────────────────────────────────────────────────

model Lead {
  id         String     @id @default(uuid())
  name       String?
  phone      String
  email      String?
  company    String?
  status     LeadStatus @default(PENDING)
  doNotCall  Boolean    @default(false)
  tenantId   String
  campaignId String
  batchId    String?
  metadata   Json?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  tenant   Tenant     @relation(fields: [tenantId], references: [id])
  campaign Campaign   @relation(fields: [campaignId], references: [id])
  batch    LeadBatch? @relation(fields: [batchId], references: [id], onDelete: Cascade)
  calls    Call[]

  @@unique([phone, campaignId])
  @@index([tenantId])
  @@index([campaignId])
  @@index([batchId])
}

enum LeadStatus {
  PENDING
  CALLING
  CALLED
  QUALIFIED
  NOT_QUALIFIED
  NO_ANSWER
  FAILED
}

// ─────────────────────────────────────────────────────────────────────────────
// CALL
// ─────────────────────────────────────────────────────────────────────────────

model Call {
  id                  String     @id @default(uuid())
  bolnaCallId         String?    @unique
  tenantId            String
  campaignId          String
  leadId              String
  batchId             String?
  status              CallStatus @default(PENDING)
  duration            Int?
  cost                Float?
  platformCost        Int?
  billableSeconds     Int?
  planVersionId       String?
  appliedRate         Int? // paisa per minute actually charged
  appliedMinSec       Int? // billing minimum used
  appliedIncrementSec Int? // billing increment used
  chargedAmount       Int? // total paisa charged (mirrors platformCost as int)
  recording           String?
  transcript          String?
  transcriptMessages  Json?
  summary             String?
  callHistory         Json?
  startedAt           DateTime?
  endedAt             DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  campaign     Campaign      @relation(fields: [campaignId], references: [id])
  lead         Lead          @relation(fields: [leadId], references: [id])
  batch        LeadBatch?    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  planVersion  PlanVersion?  @relation(fields: [planVersionId], references: [id])
  callAnalysis CallAnalysis?

  @@index([tenantId])
  @@index([campaignId])
  @@index([leadId])
  @@index([batchId])
}

enum CallStatus {
  PENDING
  CALLING
  COMPLETED
  FAILED
  NO_ANSWER
  BUSY
}

// ─────────────────────────────────────────────────────────────────────────────
// CALL ANALYSIS
// ─────────────────────────────────────────────────────────────────────────────

model CallAnalysis {
  id       String @id @default(uuid())
  callId   String @unique
  tenantId String

  disposition             Disposition?
  leadTemperature         LeadTemperature?
  preferredConfiguration  String?
  budgetRange             String?
  purchaseTimeline        PurchaseTimeline?
  purchasePurpose         PurchasePurpose?
  locationMatch           LocationMatch?
  customerLocationPref    String?
  preferredNextAction     PreferredNextAction?
  preferredContactChannel ContactChannel?
  followupSchedule        String?
  doNotCall               ExtractionFlag?
  languageSupportRequired ExtractionFlag?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  call   Call   @relation(fields: [callId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([callId])
  @@index([disposition])
  @@index([leadTemperature])
}

enum Disposition {
  INTERESTED_SEND_DETAILS
  QUALIFIED_CONSULTANT_FOLLOWUP
  SITE_VISIT_INTEREST
  INTERESTED_GENERAL
  FOLLOWUP_REQUESTED
  NOT_INTERESTED
  DO_NOT_CALL
  WRONG_NUMBER
  ALREADY_PURCHASED
  BROKER
  LANGUAGE_CALLBACK_REQUIRED
  CALL_ENDED_BY_CUSTOMER
  CALL_ENDED_ABUSIVE
  NO_RESPONSE
  CALL_DROPPED
}

enum LeadTemperature {
  HOT
  WARM
  NURTURE
  COLD
  NOT_APPLICABLE
}

enum PurchaseTimeline {
  WITHIN_3_MONTHS
  WITHIN_6_MONTHS
  WITHIN_1_YEAR
  AFTER_1_YEAR
  FLEXIBLE
  NOT_SHARED
}

enum PurchasePurpose {
  OWN_USE
  INVESTMENT
  BOTH
  NOT_SHARED
}

enum PreferredNextAction {
  SEND_DETAILS
  CONSULTANT_CALL
  SITE_VISIT
  FOLLOWUP_CALL
  NONE
}

enum ContactChannel {
  WHATSAPP
  EMAIL
  NOT_ASKED
}

enum LocationMatch {
  MATCH
  MISMATCH
  NOT_ASKED
  NOT_MENTIONED
}

enum ExtractionFlag {
  YES
  NO
}

// ─────────────────────────────────────────────────────────────────────────────
// PLANS & BILLING
// ─────────────────────────────────────────────────────────────────────────────

enum PricingModel {
  STANDARD
  VOLUME
  CUSTOM
}

enum CallingChannel {
  SHARED
  DEDICATED
  DEDICATED_WITH_NUMBER
}

enum DashboardTier {
  BASIC
  STANDARD
  ADVANCED
  CUSTOM
}

enum AgentCapability {
  BASIC
  BASIC_KNOWLEDGE
  ADVANCED_KNOWLEDGE
  CUSTOM
}

enum IntegrationTier {
  NONE
  BASIC
  API_SELECTED
  CUSTOM
}

enum SupportTier {
  STANDARD
  PRIORITY
  SLA
}

// ── Plan (product family — stable, metadata only) ──────────────────────────

model Plan {
  id           String  @id @default(uuid())
  name         String
  slug         String  @unique
  isActive     Boolean @default(true)
  displayOrder Int     @default(0)
  description  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions    PlanVersion[]
  tenantPlans TenantPlan[]
  invites     TenantInvite[]
}

// ── Plan Version (immutable commercial snapshot) ───────────────────────────

enum PlanVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model PlanVersion {
  id       String            @id @default(uuid())
  planId   String
  version  Int // monotonic per plan: 1, 2, 3…
  status   PlanVersionStatus @default(DRAFT)
  currency String            @default("INR")

  // ── Pricing (all values in paisa) ──
  pricingModel          PricingModel @default(STANDARD)
  onboardingFee         Int
  onboardingFeeOriginal Int?
  perMinuteRate         Int
  billingMinimumSec     Int          @default(30)
  billingIncrementSec   Int          @default(15)

  // ── Limits (NULL = unlimited) ──
  maxActiveCampaigns Int?
  maxLeadsPerBatch   Int?
  maxAgents          Int?
  maxTeamMembers     Int?
  retryAutomation    Boolean @default(false)
  industryPackLimit  Int?

  // ── Capabilities ──
  callingChannel CallingChannel @default(SHARED)
  brochureUpload Boolean        @default(false)

  // ── Feature Tiers ──
  dashboardTier   DashboardTier   @default(BASIC)
  agentCapability AgentCapability @default(BASIC)
  integrations    IntegrationTier @default(NONE)
  supportTier     SupportTier     @default(STANDARD)

  // ── Wallet / Bonus ──
  lowBalanceThreshold Int  @default(10000)
  includedBalance     Int  @default(0)
  bonusValidityDays   Int?

  // ── Lifecycle ──
  publishedAt DateTime?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // ── Relations ──
  plan        Plan              @relation(fields: [planId], references: [id])
  tenantPlans TenantPlan[]
  calls       Call[]
  eventsFrom  TenantPlanEvent[] @relation("EventFromVersion")
  eventsTo    TenantPlanEvent[] @relation("EventToVersion")

  @@unique([planId, version])
  @@index([status])
}

// ── Tenant Plan (current assignment + overrides) ───────────────────────────

enum TenantPlanStatus {
  PENDING_PAYMENT
  ACTIVE
  EXPIRED
  CANCELLED
}

model TenantPlan {
  id            String           @id @default(uuid())
  tenantId      String           @unique
  planId        String // family reference
  planVersionId String // exact commercial version
  status        TenantPlanStatus @default(PENDING_PAYMENT)

  // ── Enterprise overrides (NULL = inherit from PlanVersion) ──
  onboardingFeeOverride Int?
  perMinuteRateOverride Int?

  activatedAt    DateTime?
  bonusExpiresAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan        Plan              @relation(fields: [planId], references: [id])
  planVersion PlanVersion       @relation(fields: [planVersionId], references: [id])
  events      TenantPlanEvent[]
  recharges   Recharge[]

  @@index([planId])
  @@index([planVersionId])
  @@index([status])
}

// ── Tenant Plan Event (immutable audit log) ────────────────────────────────

enum TenantPlanEventType {
  CREATED
  ACTIVATED
  PLAN_CHANGED
  OVERRIDES_UPDATED
  BONUS_GRANTED
  BONUS_EXPIRED
  CANCELLED
  EXPIRED
  REACTIVATED
}

model TenantPlanEvent {
  id           String              @id @default(uuid())
  tenantPlanId String
  tenantId     String
  type         TenantPlanEventType

  fromPlanVersionId String?
  toPlanVersionId   String?

  metadata  Json?
  createdBy String?
  createdAt DateTime @default(now())

  tenantPlan  TenantPlan   @relation(fields: [tenantPlanId], references: [id], onDelete: Cascade)
  fromVersion PlanVersion? @relation("EventFromVersion", fields: [fromPlanVersionId], references: [id])
  toVersion   PlanVersion? @relation("EventToVersion", fields: [toPlanVersionId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantPlanId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// WALLET 
// ─────────────────────────────────────────────────────────────────────────────

model Wallet {
  id             String    @id @default(uuid())
  tenantId       String    @unique
  cashBalance    Int       @default(0) // cash from recharges only
  bonusBalance   Int       @default(0) // promotional balance only
  bonusExpiresAt DateTime?
  currency       String    @default("INR")
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
  recharges    Recharge[]
}

// ── Wallet Transaction (append-only ledger) ────────────────────────────────

enum WalletTxType {
  CREDIT // cash added via recharge
  DEBIT // spent on calls
  BONUS // promotional bonus granted
  BONUS_EXPIRY // bonus clawed back on expiry
  REFUND // reversal of a previous debit
  ADJUSTMENT // manual admin correction
}

enum WalletTxSourceType {
  RECHARGE
  CALL
  PLAN_BONUS
  BONUS_EXPIRY
  ADMIN_ADJUSTMENT
  REFUND
}

model WalletTransaction {
  id       String @id @default(uuid())
  walletId String
  tenantId String // denormalized for query speed; app enforces consistency

  type       WalletTxType
  amount     Int // always positive; type determines direction
  cashDelta  Int // signed: how cash changed (+/-)
  bonusDelta Int // signed: how bonus changed (+/-)

  cashBalanceAfter  Int
  bonusBalanceAfter Int
  currency          String @default("INR")
  description       String

  sourceType     WalletTxSourceType?
  sourceId       String?
  idempotencyKey String? // explicit idempotency guard

  createdAt DateTime @default(now())
  createdBy String?

  wallet Wallet @relation(fields: [walletId], references: [id])

  // Idempotency: one transaction per (wallet, key) when key is provided.
  // Postgres treats NULLs as distinct, so rows without a key are unconstrained.
  @@unique([walletId, idempotencyKey], name: "uniq_wallet_tx_idem")
  @@index([tenantId, createdAt])
  @@index([walletId, createdAt])
  @@index([sourceType, sourceId])
}

// ── Recharge (payment operation) ───────────────────────────────────────────

enum RechargeStatus {
  INITIATED
  SUCCESS
  FAILED
  REFUNDED
}

enum RechargePurpose {
  ONBOARDING
  WALLET_TOPUP
}

model Recharge {
  id       String          @id @default(uuid())
  walletId String
  tenantId String
  amount   Int
  currency String          @default("INR")
  purpose  RechargePurpose @default(WALLET_TOPUP)
  status   RechargeStatus

  // ── Provider fields ──
  provider          String  @default("razorpay")
  razorpayOrderId   String? @unique
  razorpayPaymentId String? @unique
  razorpaySignature String?
  failureReason     String?

  // ── Association ──
  tenantPlanId String? // links onboarding payment to the TenantPlan it activates
  targetPlanVersionId String? 

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  wallet     Wallet      @relation(fields: [walletId], references: [id])
  tenantPlan TenantPlan? @relation(fields: [tenantPlanId], references: [id])

  @@index([tenantId, status])
  @@index([tenantPlanId])
}

// ─────────────────────────────────────────────────────────────────────────────
// BOLNA API KEYS
// ─────────────────────────────────────────────────────────────────────────────

model BolnaApiKey {
  id                String          @id @default(uuid())
  keyIdentifier     String
  encryptedKey      String
  type              BolnaApiKeyType @default(GENERAL)
  isPlatformDefault Boolean         @default(false)
  isActive          Boolean         @default(true)

  createdBy      String // PlatformAdmin userId
  lastAccessedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenants Tenant[] // Reverse relation
}

enum BolnaApiKeyType {
  GENERAL
  CUSTOM
}

model TenantInvite {
  id                    String       @id @default(uuid())
  email                 String
  tenantName            String
  token                 String       @unique
  status                InviteStatus @default(PENDING)
  planId                String
  invitedBy             String
  expiresAt             DateTime
  acceptedAt            DateTime?
  resendCount           Int          @default(0)
  lastResentAt          DateTime?
  skipPayment           Boolean      @default(false)       // ← NEW
  discountPercent       Int          @default(0)           // ← NEW (0-100)
  creditIncludedBalance Boolean      @default(true)        // ← NEW
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  plan Plan @relation(fields: [planId], references: [id])

  @@index([token])
  @@index([email])
  @@index([status])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}


// ─────────────────────────────────────────────────────────────────────────────
// INDUSTRY ENUM (Phase 1 — used by PlatformAgent; IndustryPack comes in Phase 3)
// ─────────────────────────────────────────────────────────────────────────────

enum Industry {
  GENERIC
  REAL_ESTATE
  BFSI
  HEALTHCARE
  RECRUITMENT
  EDUCATION
  ECOMMERCE
}

// ─────────────────────────────────────────────────────────────────────────────
// PLATFORM AGENT (pre-built templates managed by KOOI admins)
// ─────────────────────────────────────────────────────────────────────────────

model PlatformAgent {
  id            String   @id @default(uuid())
  bolnaId       String   @unique
  slug          String   @unique
  name          String
  category      String?
  description   String?

  defaultConfig Json
  systemPrompt  String?

  isActive      Boolean  @default(true)
  isFeatured    Boolean  @default(false)
  sortOrder     Int      @default(0)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  industryPackId String?
  industryPack   IndustryPack? @relation(fields: [industryPackId], references: [id], onDelete: SetNull)

  assistants    Assistant[]
  extractionCategories ExtractionCategory[]

  @@index([industryPackId])
  @@index([category])
}

// ─────────────────────────────────────────────────────────────────────────────
// EXTRACTION CATEGORY (synced from Bolna, platform-scoped catalog)
// ─────────────────────────────────────────────────────────────────────────────

model ExtractionCategory {
  id          String   @id @default(uuid())
  bolnaId     String?  @unique
  slug        String   @unique
  name        String
  model       String   @default("gpt-4.1-mini")
  industry    Industry @default(GENERIC)
  description String?
  isActive    Boolean  @default(true)

  platformAgentId String?
  platformAgent   PlatformAgent? @relation(fields: [platformAgentId], references: [id], onDelete: SetNull)

  dispositions ExtractionDisposition[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([industry])
  @@index([platformAgentId])
}

// ─────────────────────────────────────────────────────────────────────────────
// EXTRACTION DISPOSITION (synced from Bolna, platform-scoped catalog)
// ─────────────────────────────────────────────────────────────────────────────

model ExtractionDisposition {
  id          String   @id @default(uuid())
  bolnaId     String?  @unique
  slug        String   @unique
  name        String
  question    String
  systemPrompt String?
  model       String   @default("gpt-4.1-mini")

  isSubjective         Boolean @default(false)
  isObjective          Boolean @default(false)
  subjectiveType       String  @default("text")
  subjectiveTypeConfig Json?
  objectiveOptions     Json?

  industry    Industry @default(GENERIC)
  description String?
  isActive    Boolean  @default(true)

  categoryId String
  category   ExtractionCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([industry])
  @@index([categoryId])
}

// ─────────────────────────────────────────────────────────────────────────────
// INDUSTRY PACK (admin-curated grouping per industry)
// ─────────────────────────────────────────────────────────────────────────────

model IndustryPack {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  industry    Industry @unique
  description String?
  icon        String?

  // Compliance rules (stored now, enforced in future phases)
  allowedCallingHours Json?   // { start: "09:00", end: "21:00", tz: "Asia/Kolkata" }
  requiresConsent     Boolean @default(false)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  platformAgents PlatformAgent[]

  @@index([industry])
}