generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// AUTH & MULTI-TENANCY
// ─────────────────────────────────────────────────────────────────────────────

model Tenant {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   TenantUser[]
  bolnaApiKeyId String?
  bolnaApiKey   BolnaApiKey?   @relation(fields: [bolnaApiKeyId], references: [id])
  tenantPlan    TenantPlan?
  wallet        Wallet?
  campaigns     Campaign[]
  batches       LeadBatch[]
  leads         Lead[]
  calls         Call[]
  assistants    Assistant[]
  brochures     Brochure[]
  callAnalyses  CallAnalysis[]

  @@index([email])
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   TenantUser[]
  platformAdmin PlatformAdmin?
  refreshTokens RefreshToken[]
}

model TenantUser {
  id        String     @id @default(uuid())
  userId    String
  tenantId  String
  role      TenantRole @default(USER)
  createdAt DateTime   @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
}

enum TenantRole {
  OWNER
  ADMIN
  USER
}

model PlatformAdmin {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// ASSISTANT
// ─────────────────────────────────────────────────────────────────────────────

model Assistant {
  id        String   @id @default(uuid())
  bolnaId   String
  name      String
  tenantId  String
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  campaigns Campaign[]
}

// ─────────────────────────────────────────────────────────────────────────────
// BROCHURE
// ─────────────────────────────────────────────────────────────────────────────

model Brochure {
  id       String @id @default(uuid())
  tenantId String

  originalFileName String
  fileSizeMB       String
  pageCount        Int
  rawTextLength    Int

  projectName    String?
  developerName  String?
  reraNumber     String?
  projectWebsite String?
  contactNumber  String?

  city        String?
  area        String?
  state       String?
  landmark    String?
  fullAddress String?

  propertyTypes  String[]
  configurations String[]
  totalUnits     Int?
  totalTowers    Int?
  totalFloors    Int?
  sizeMin        Float?
  sizeMax        Float?
  sizeUnit       String?

  startingPrice     Float?
  maxPrice          Float?
  pricePerSqft      Float?
  priceLabel        String?
  paymentPlan       String?
  bankApprovals     String[]
  maintenanceCharge String?

  possessionDate     String?
  launchDate         String?
  constructionStatus String? @default("unknown")

  amenities            String[]
  specifications       String[]
  nearbyInfrastructure String[]
  usps                 String[]

  minimumBudget          Float?
  maximumBudget          Float?
  targetBuyerProfile     String?
  preferredLocations     String[]
  investmentType         String[]
  keyQualifyingQuestions String[]

  confidence         Float    @default(0)
  extractionWarnings String[]

  isConfirmed Boolean   @default(false)
  confirmedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  campaigns Campaign[]

  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────────────────────
// CAMPAIGN
// ─────────────────────────────────────────────────────────────────────────────

model Campaign {
  id                 String         @id @default(uuid())
  name               String
  description        String?
  status             CampaignStatus @default(DRAFT)
  tenantId           String
  assistantId        String
  brochureId         String?
  variables          Json?
  defaultRetryConfig Json?
  totalLeads         Int            @default(0)
  calledLeads        Int            @default(0)
  completedLeads     Int            @default(0)
  failedLeads        Int            @default(0)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  startedAt          DateTime?
  completedAt        DateTime?

  tenant    Tenant      @relation(fields: [tenantId], references: [id])
  assistant Assistant   @relation(fields: [assistantId], references: [id])
  brochure  Brochure?   @relation(fields: [brochureId], references: [id])
  leads     Lead[]
  calls     Call[]
  batches   LeadBatch[]

  @@index([brochureId])
}

enum CampaignStatus {
  DRAFT
  RUNNING
  COMPLETED
  FAILED
}

// ─────────────────────────────────────────────────────────────────────────────
// LEAD BATCH
// ─────────────────────────────────────────────────────────────────────────────

model LeadBatch {
  id                String      @id @default(uuid())
  bolnaBatchId      String?     @unique
  campaignId        String
  tenantId          String
  status            BatchStatus @default(CREATED)
  fileName          String?
  originalFileUrl   String?
  transformedCsvUrl String?
  totalLeads        Int         @default(0)
  calledLeads       Int         @default(0)
  completedLeads    Int         @default(0)
  failedLeads       Int         @default(0)
  retryConfig       Json?
  scheduledAt       DateTime?
  bolnaScheduledAt  DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  startedAt         DateTime?
  completedAt       DateTime?

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leads    Lead[]
  calls    Call[]

  @@index([tenantId])
  @@index([campaignId])
  @@index([bolnaBatchId])
}

enum BatchStatus {
  CREATED
  SCHEDULED
  RUNNING
  STOPPED
  COMPLETED
  FAILED
}

// ─────────────────────────────────────────────────────────────────────────────
// LEAD
// ─────────────────────────────────────────────────────────────────────────────

model Lead {
  id         String     @id @default(uuid())
  name       String?
  phone      String
  email      String?
  company    String?
  status     LeadStatus @default(PENDING)
  doNotCall  Boolean    @default(false)
  tenantId   String
  campaignId String
  batchId    String?
  metadata   Json?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  tenant   Tenant     @relation(fields: [tenantId], references: [id])
  campaign Campaign   @relation(fields: [campaignId], references: [id])
  batch    LeadBatch? @relation(fields: [batchId], references: [id], onDelete: Cascade)
  calls    Call[]

  @@unique([phone, campaignId])
  @@index([tenantId])
  @@index([campaignId])
  @@index([batchId])
}

enum LeadStatus {
  PENDING
  CALLING
  CALLED
  QUALIFIED
  NOT_QUALIFIED
  NO_ANSWER
  FAILED
}

// ─────────────────────────────────────────────────────────────────────────────
// CALL
// ─────────────────────────────────────────────────────────────────────────────

model Call {
  id                 String     @id @default(uuid())
  bolnaCallId        String?    @unique
  tenantId           String
  campaignId         String
  leadId             String
  batchId            String?
  status             CallStatus @default(PENDING)
  duration           Int?
  cost               Float?
  platformCost       Int?
  billableSeconds    Int? // NEW: Rounded seconds used for billing
  recording          String?
  transcript         String?
  transcriptMessages Json?
  summary            String?
  callHistory        Json?
  startedAt          DateTime?
  endedAt            DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  campaign     Campaign      @relation(fields: [campaignId], references: [id])
  lead         Lead          @relation(fields: [leadId], references: [id])
  batch        LeadBatch?    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  callAnalysis CallAnalysis?

  @@index([tenantId])
  @@index([campaignId])
  @@index([leadId])
  @@index([batchId])
}

enum CallStatus {
  PENDING
  CALLING
  COMPLETED
  FAILED
  NO_ANSWER
  BUSY
}

// ─────────────────────────────────────────────────────────────────────────────
// CALL ANALYSIS
// ─────────────────────────────────────────────────────────────────────────────

model CallAnalysis {
  id       String @id @default(uuid())
  callId   String @unique
  tenantId String

  disposition             Disposition?
  leadTemperature         LeadTemperature?
  preferredConfiguration  String?
  budgetRange             String?
  purchaseTimeline        PurchaseTimeline?
  purchasePurpose         PurchasePurpose?
  locationMatch           LocationMatch?
  customerLocationPref    String?
  preferredNextAction     PreferredNextAction?
  preferredContactChannel ContactChannel?
  followupSchedule        String?
  doNotCall               ExtractionFlag?
  languageSupportRequired ExtractionFlag?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  call   Call   @relation(fields: [callId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([callId])
  @@index([disposition])
  @@index([leadTemperature])
}

enum Disposition {
  INTERESTED_SEND_DETAILS
  QUALIFIED_CONSULTANT_FOLLOWUP
  SITE_VISIT_INTEREST
  INTERESTED_GENERAL
  FOLLOWUP_REQUESTED
  NOT_INTERESTED
  DO_NOT_CALL
  WRONG_NUMBER
  ALREADY_PURCHASED
  BROKER
  LANGUAGE_CALLBACK_REQUIRED
  CALL_ENDED_BY_CUSTOMER
  CALL_ENDED_ABUSIVE
  NO_RESPONSE
  CALL_DROPPED
}

enum LeadTemperature {
  HOT
  WARM
  NURTURE
  COLD
  NOT_APPLICABLE
}

enum PurchaseTimeline {
  WITHIN_3_MONTHS
  WITHIN_6_MONTHS
  WITHIN_1_YEAR
  AFTER_1_YEAR
  FLEXIBLE
  NOT_SHARED
}

enum PurchasePurpose {
  OWN_USE
  INVESTMENT
  BOTH
  NOT_SHARED
}

enum PreferredNextAction {
  SEND_DETAILS
  CONSULTANT_CALL
  SITE_VISIT
  FOLLOWUP_CALL
  NONE
}

enum ContactChannel {
  WHATSAPP
  EMAIL
  NOT_ASKED
}

enum LocationMatch {
  MATCH
  MISMATCH
  NOT_ASKED
  NOT_MENTIONED
}

enum ExtractionFlag {
  YES
  NO
}

// ─────────────────────────────────────────────────────────────────────────────
// PLANS & SUBSCRIPTIONS
// ─────────────────────────────────────────────────────────────────────────────

model Plan {
  id           String  @id @default(uuid())
  name         String
  slug         String  @unique
  isActive     Boolean @default(true)
  displayOrder Int     @default(0)

  // Pricing (in paisa)
  onboardingFee       Int
  perMinuteRate       Int
  billingMinimumSec   Int @default(30)
  billingIncrementSec Int @default(15)

  // Limits
  maxActiveCampaigns Int?
  maxLeadsPerBatch   Int?
  retryAutomation    Boolean @default(false)
  industryPackLimit  Int?

  // Features JSON
  features Json

  // Bonus
  includedBalance   Int  @default(0)
  bonusValidityDays Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantPlans TenantPlan[]
  invites     TenantInvite[]
}

model TenantPlan {
  id             String     @id @default(uuid())
  tenantId       String     @unique
  planId         String
  status         PlanStatus @default(PENDING_PAYMENT)
  activatedAt    DateTime?
  bonusExpiresAt DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])
}

enum PlanStatus {
  PENDING_PAYMENT
  ACTIVE
  EXPIRED
  CANCELLED
}

// ─────────────────────────────────────────────────────────────────────────────
// BOLNA API KEYS
// ─────────────────────────────────────────────────────────────────────────────

model BolnaApiKey {
  id                String          @id @default(uuid())
  keyIdentifier     String
  encryptedKey      String
  type              BolnaApiKeyType @default(GENERAL)
  isPlatformDefault Boolean         @default(false)
  isActive          Boolean         @default(true)

  createdBy      String // PlatformAdmin userId
  lastAccessedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenants Tenant[] // Reverse relation
}

enum BolnaApiKeyType {
  GENERAL
  CUSTOM
}

model TenantInvite {
  id           String       @id @default(uuid())
  email        String
  tenantName   String
  token        String       @unique
  status       InviteStatus @default(PENDING)
  planId       String
  invitedBy    String
  expiresAt    DateTime
  acceptedAt   DateTime?
  resendCount  Int          @default(0)
  lastResentAt DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  plan Plan @relation(fields: [planId], references: [id])

  @@index([token])
  @@index([email])
  @@index([status])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model Wallet {
  id                  String    @id @default(uuid())
  tenantId            String    @unique
  balance             Int       @default(0)
  bonusBalance        Int       @default(0)
  bonusExpiresAt      DateTime?
  isActive            Boolean   @default(true)
  lowBalanceThreshold Int?      @default(10000)
  lowBalanceAlertSent Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
  recharges    Recharge[]
}

model WalletTransaction {
  id                String       @id @default(uuid())
  walletId          String
  tenantId          String
  type              WalletTxType
  amount            Int
  balanceAfter      Int
  bonusBalanceAfter Int
  description       String
  referenceType     String?
  referenceId       String?
  createdAt         DateTime     @default(now())
  createdBy         String?

  wallet Wallet @relation(fields: [walletId], references: [id])

  @@unique([referenceType, referenceId])
  @@index([tenantId, createdAt])
  @@index([walletId, createdAt])
}

model Recharge {
  id                String          @id @default(uuid())
  walletId          String
  tenantId          String
  amount            Int
  purpose           RechargePurpose @default(WALLET_TOPUP)
  status            RechargeStatus
  razorpayOrderId   String?         @unique
  razorpayPaymentId String?         @unique
  razorpaySignature String?
  failureReason     String?
  planId            String?
  createdAt         DateTime        @default(now())
  completedAt       DateTime?

  wallet Wallet @relation(fields: [walletId], references: [id])

  @@index([tenantId, status])
}

enum WalletTxType {
  CREDIT
  DEBIT
  REFUND
  BONUS
  ADJUSTMENT
}

enum RechargeStatus {
  INITIATED
  SUCCESS
  FAILED
  REFUNDED
}

enum RechargePurpose {
  ONBOARDING
  WALLET_TOPUP
}
