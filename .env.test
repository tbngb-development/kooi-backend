PORT=5002
NODE_ENV=test
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Isolated local test database
DATABASE_URL=postgresql://postgres:xdv14nmjad@localhost:5432/kooi-test

# Auth test secrets
JWT_SECRET=test_super_secret_jwt_key_minimum_32_chars_long_for_kooi_saas_testing
